#!/bin/bash
# First-run setup on the handheld (run by Cuphead.sh through PortMaster's patcher): builds the game
# for Unity's Android player from the player's own copy of Cuphead in ports/cuphead/gamedata/:
#   - the installed game: Cuphead.app (GOG macOS 1.3.4, with or without The Delicious Last Course)
#   - or GOG's macOS installers (*.pkg: the game, and the DLC's if you have it)
# Unity 2017.4.9f1's Android player comes from Unity: downloaded (about 190 MB, needs Wi-Fi), or put
# UnitySetup-Android-Support-for-Editor-2017.4.9f1.exe in gamedata/ yourself.
# Tools: PortMaster's 7-Zip, and ports/cuphead/setup/ (Python with the converter, the code patcher,
# the port's helper), removed when the setup is done. Every step can be interrupted (battery, power
# button): the next launch continues where it stopped.
GD="$GAMEDIR/gamedata"; D="$GD/Cuphead_Data"; S="$GAMEDIR/setup"; W="$GD/.setup"
UNITY_URL=https://download.unity3d.com/download_unity/6d84dfc57ccf/TargetSupportInstaller/UnitySetup-Android-Support-for-Editor-2017.4.9f1.exe
UNITY_SHA256=079b39d13f451025601d10d2f100868f51092134ff7dee963bc2fa36a58701b9
UNITY_EXE=$(basename "$UNITY_URL")
PKG='$INSTDIR$_59_'

exec > >(tee -a "$GAMEDIR/patchlog.txt") 2>&1
echo "=== $(date) Cuphead setup ==="
fail() { echo "PATCH_FAIL_MSG:$1"; echo "Setup failed: $1"; echo "Patching process failed!"; exit 1; }
step() { echo; echo "== $(date +%H:%M:%S) $*"; }
SEVENZ="$controlfolder/7zzs.$DEVICE_ARCH"
[ -x "$SEVENZ" ] || fail "PortMaster's 7-Zip is missing: update PortMaster."
mkdir -p "$W" || fail "Cannot write to ports/cuphead/gamedata."
free_mb() { df -m "$GD" | awk 'NR==2{print $4}'; }
echo "RAM $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo) MB, swap $(awk '/SwapTotal/{print int($2/1024)}' /proc/meminfo) MB, free on the card $(free_mb) MB"

# ---- the setup's Python (CPython + UnityPy and the image/audio libraries, aarch64)
PY="$W/python/bin/python3.12"
if ! "$PY" -c "import UnityPy, lz4, astc_encoder, PIL" 2>/dev/null; then
  step "unpacking the setup tools"
  rm -rf "$W/python"
  tar -xzf "$S/python.tar.gz" -C "$W" || fail "Could not unpack the setup's Python (see patchlog.txt)."
fi
export PYTHONPATH="$S" PYTHONDONTWRITEBYTECODE=1
pm() { (cd "$S" && "$PY" -m pmunity "$@"); }

# ---- 1. the game: Cuphead.app, or GOG's macOS installers
if [ ! -f "$W/.step_game" ]; then
  if [ ! -f "$D/globalgamemanagers" ]; then
    APP=$(ls -d "$GD"/Cuphead.app "$GD"/*/Cuphead.app 2>/dev/null | head -1)
    if [ -z "$APP" ]; then
      PKGS=$(ls -S "$GD"/*.pkg 2>/dev/null)              # largest first: the game, then the DLC
      if [ -n "$PKGS" ]; then
        [ "$(free_mb)" -gt 9000 ] || fail "Unpacking the installers needs about 9 GB free on the card ($(free_mb) MB free)."
        step "unpacking GOG's installers (about 10-20 minutes)"
        rm -rf "$W/pkgroot"
        # shellcheck disable=SC2086
        pm macpkg "$W/pkgroot" $PKGS || fail "Could not unpack the installers (see patchlog.txt)."
        APP=$(find "$W/pkgroot" -maxdepth 4 -type d -name 'Cuphead.app' | head -1)
      elif ls "$GD"/setup_cuphead*.exe >/dev/null 2>&1; then
        fail "These are the Windows installers: the port needs the macOS version of Cuphead (its shaders are OpenGL; Windows has only Direct3D). GOG offers both with the game."
      fi
    fi
    [ -n "$APP" ] || fail "Put the installed Cuphead.app (GOG macOS) or GOG's macOS installers (.pkg) in ports/cuphead/gamedata, then launch again."
    [ -f "$APP/Contents/Resources/Data/globalgamemanagers" ] || fail "$(basename "$APP") has no game data."
    grep -aq "2017.4.9f1" "$APP/Contents/Resources/Data/globalgamemanagers" \
      || fail "This Cuphead version is not supported (the port needs 1.3.4, Unity 2017.4.9f1)."
    step "moving the game's data into place"
    cp "$APP/Contents/Resources/"goggame-*.info "$GD/" 2>/dev/null
    rm -rf "$GD/mono-etc"; cp -r "$APP/Contents/Mono/etc" "$GD/mono-etc" || fail "The game's Mono folder is missing."
    mv "$APP/Contents/Resources/Data" "$D.tmp" && mv "$D.tmp" "$D" || fail "Could not move the game's data (see patchlog.txt)."
    rm -rf "$W/pkgroot" "$APP"
  fi
  [ -f "$GD/goggame-2048763853.info" ] && echo "The Delicious Last Course: installed" || echo "The Delicious Last Course: not installed"
  touch "$W/.step_game"
fi

# ---- 2. Unity's Android player 2017.4.9f1, from Unity
P="$W/player/$PKG"
if [ ! -f "$W/.step_player" ]; then
  I="$GD/$UNITY_EXE"
  [ -f "$I" ] || I="$W/$UNITY_EXE"
  if [ "$(sha256sum "$I" 2>/dev/null | cut -d' ' -f1)" != "$UNITY_SHA256" ]; then
    I="$W/$UNITY_EXE"; rm -f "$I"
    step "downloading Unity's Android player 2017.4.9f1 from Unity (about 190 MB)"
    if command -v curl >/dev/null; then curl -fL --retry 3 -o "$I" "$UNITY_URL"; else wget -O "$I" "$UNITY_URL"; fi
    [ "$(sha256sum "$I" 2>/dev/null | cut -d' ' -f1)" = "$UNITY_SHA256" ] \
      || fail "Downloading Unity's player failed: is Wi-Fi on? (Or put $UNITY_EXE in ports/cuphead/gamedata.)"
  fi
  step "unpacking Unity's player"
  rm -rf "$W/player"
  "$SEVENZ" x -y -o"$W/player" "$I" "$PKG/Variations/mono/Release/Libs/armeabi-v7a/*" \
    "$PKG/Variations/mono/Release/MonoLibs/armeabi-v7a/libmono.so" "$PKG/Variations/mono/Managed/*" \
    "$PKG/Data/unity default resources" >/dev/null || fail "Could not unpack Unity's player (see patchlog.txt)."
  [ -f "$P/Variations/mono/Release/Libs/armeabi-v7a/libunity.so" ] || fail "Unity's player is incomplete (see patchlog.txt)."
  [ "$I" = "$W/$UNITY_EXE" ] && rm -f "$I"
  touch "$W/.step_player"
fi

# ---- 3. conversion: GLES3 shaders, settings, ASTC textures, audio, the helper's animation table
# texture quality: the answer the first setup run got (kept, so a resumed setup never mixes
# qualities), else TEXTURE_QUALITY (PortMaster's patcher question, setup/questions.lua), else
# ports/cuphead/setup.txt (texture_quality=medium|fast; older PortMaster asks no questions), else
# medium. fast: ASTC encoded about 2.5x faster (a shorter setup), slightly lower quality (about
# 0.7 dB); medium is what the port is tested with.
Q=$(cat "$W/.texture_quality" 2>/dev/null)
[ -n "$Q" ] || Q=${TEXTURE_QUALITY:-$(sed -n 's/^[[:space:]]*texture_quality[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$GAMEDIR/setup.txt" 2>/dev/null | tail -1)}
case "$Q" in fast|medium) ;; *) Q=medium;; esac
echo "$Q" > "$W/.texture_quality"
if [ ! -f "$W/.step_convert" ]; then
  step "converting the game (the long part: one to a few hours; it continues where it stopped if interrupted)"
  echo "texture quality: $Q"
  pm convert "$D" --config "$S/cuphead.json" --plugin "$S/animclips.py" --set textures.quality="$Q" \
    || fail "Converting the game's files failed (see patchlog.txt). Launch again to continue."
  touch "$W/.step_convert"
fi

# ---- 4. what Unity's Android player reads: APK + OBB (the data's files are moved into them)
if [ ! -f "$W/.step_package" ]; then
  step "packing the game for the player"
  chmod +x "$S/codepatch"
  pm android-data --src "$D" --pkg "$P" --out "$W/android" --name Cuphead --package com.cupheadport.game \
    --root-file animclips.txt --managed-file "$S/CupheadPort.dll" --game-managed "$D/Managed" \
    --assembly-patch Assembly-CSharp.dll "env DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 '$S/codepatch' --target=android {managed} {out}" \
    --mono-etc "$GD/mono-etc" --dllmap SDL2=libSDL2-2.0.so.0 --consume-src --verify-bundles 2 --pack all --no-video-shader \
    || fail "Packing the game failed (see patchlog.txt). Launch again to continue."
  touch "$W/.step_package"
fi

# ---- 5. into place
step "installing"
Z="$W/android/zip"
mkdir -p "$GAMEDIR/lib"
for f in Libs/armeabi-v7a/libmain.so Libs/armeabi-v7a/libunity.so MonoLibs/armeabi-v7a/libmono.so; do
  cp "$P/Variations/mono/Release/$f" "$GAMEDIR/lib/" || fail "Could not install Unity's player."
done
[ -d "$Z/assets" ] && rm -rf "$GAMEDIR/assets"        # (an interrupted install moved it already)
for f in "$Z"/*; do
  [ -e "$f" ] || continue
  mv -f "$f" "$GAMEDIR/" || fail "Could not install $(basename "$f")."
done
rm -rf "$W" "$D" "$GD/mono-etc" "$S"
sync
touch "$GAMEDIR/.cuphead_ready"
# the installers (or what is left of Cuphead.app) are not needed any more: removed, as PortMaster
# ports' setups do, unless setup.txt says keep_installers=1
keep=$(sed -n 's/^[[:space:]]*keep_installers[[:space:]]*=[[:space:]]*\([01]\).*/\1/p' "$GAMEDIR/setup.txt" 2>/dev/null | tail -1)
left=$(ls -d "$GD"/*.pkg "$GD"/*.app "$GD"/goggame-*.info 2>/dev/null)
if [ -n "$left" ] && [ "$keep" != 1 ]; then
  freed=$(IFS=$'\n'; du -scm $left 2>/dev/null | tail -1 | cut -f1)
  (IFS=$'\n'; rm -rf $left)
  echo "removed the installers from gamedata/ (${freed} MB; keep_installers=1 in setup.txt keeps them)"
elif [ -n "$left" ]; then
  echo "kept the installers in gamedata/ (keep_installers=1)"
fi
sync
step "setup finished: $(du -sm "$GAMEDIR" | cut -f1) MB."
