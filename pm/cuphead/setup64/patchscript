#!/bin/bash
# First-run setup of Cuphead's 64-bit build (run by launch64.sh through PortMaster's patcher, on a
# system without 32-bit support or with CUPHEAD_ROUTE=64): builds the game for Unity's 64-bit
# Android player from the player's own copy of Cuphead in ports/cuphead/gamedata/, as
# setup/patchscript does for the 32-bit build:
#   - the installed game: Cuphead.app (GOG macOS 1.3.4, with or without The Delicious Last Course)
#   - or GOG's macOS installers (*.pkg: the game, and the DLC's if you have it)
# What differs: Unity made 64-bit ARM Android players only for IL2CPP (the game's C# code compiled
# ahead of time into native code), and none for Cuphead's Unity version (2017.4.9f1). So the setup
# takes the IL2CPP player of the same Unity line, 2017.4.40f1 (about 7 MB read from Unity's
# installer; or put UnitySetup-Android-Support-for-Editor-2017.4.40f1.exe in gamedata/), and
# compiles the game's code for it on the handheld (the IL2CPP step, hours on a small handheld).
# Tools: ports/cuphead/setup/ (Python with the converter, the code patcher, the port's helper: the
# same as the 32-bit setup's) and setup64/; both are removed when the setup is done. Work folder:
# gamedata/.setup64/. Every step can be interrupted (battery, power button): the next launch
# continues where it stopped. The result goes into ports/cuphead/arm64/, marked by .cuphead_ready64.
GD="$GAMEDIR/gamedata"; S="$GAMEDIR/setup"; S64="$GAMEDIR/setup64"; W="$GD/.setup64"
D="$W/Cuphead_Data"                     # the game's data (converted in place)
A="$GAMEDIR/arm64"                      # what ua_host64 runs: lib/, the APK, data/ (the saves)
UNITY=2017.4.40f1                       # the IL2CPP player's Unity version (and its il2cpp's)
UNITY_URL=https://download.unity3d.com/download_unity/6e14067f8a9a/TargetSupportInstaller/UnitySetup-Android-Support-for-Editor-2017.4.40f1.exe
UNITY_EXE=$(basename "$UNITY_URL")
PLAYER_SHA256="libmain.so=70e113ef3db212451f69881194381cdbe742720e52125216b7b46bc5bd2b6e22
               libunity.so=79eddea99a16ceeac6d590df318baba769a1d00aaa10f7858d45e82bd28096db"
PLAYER_LIBS="$W/player/Variations/il2cpp/Release/Libs/arm64-v8a"
# free space (MB). Unpacking the installers needs about 9 GB (as the 32-bit setup); they stay on
# the card until the end, so the IL2CPP step's build files (an estimate until measured on a
# handheld) come on top
PKG_SPACE_MB=12000
IL2CPP_SPACE_MB=3000

exec > >(tee -a "$GAMEDIR/patchlog.txt") 2>&1
echo "=== $(date) Cuphead setup (64-bit build) ==="
fail() { echo "PATCH_FAIL_MSG:$1"; echo "Setup failed: $1"; echo "Patching process failed!"; exit 1; }
step() { echo; echo "== $(date +%H:%M:%S) $*"; }
free_mb() { df -Pm "$GD" | awk 'NR==2{print $4}'; }
room() { local f; f=$(free_mb); [ -z "$f" ] || [ "$f" -gt "$1" ]; }   # room <MB>: that much free (or unknown)
[ "$(uname -m)" = aarch64 ] || fail "Cuphead's 64-bit build needs a 64-bit ARM (aarch64) system (this one: $(uname -m))."
for f in python.tar.gz pmunity/__main__.py codepatch CupheadPort.dll cuphead.json animclips.py; do
  [ -f "$S/$f" ] || fail "The setup's tools (ports/cuphead/setup/) are gone: an earlier setup removed them. Install cuphead.zip again, put your copy of Cuphead in ports/cuphead/gamedata and launch again."
done
mkdir -p "$W" || fail "Cannot write to ports/cuphead/gamedata."
echo "RAM $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo) MB, swap $(awk '/SwapTotal/{print int($2/1024)}' /proc/meminfo) MB, CPUs $(nproc 2>/dev/null), free on the card $(free_mb) MB"
# Python's TLS needs the system's CA certificates (for Unity's servers)
if [ -z "$SSL_CERT_FILE" ]; then
  for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem /etc/ssl/ca-bundle.pem; do
    [ -f "$f" ] && { export SSL_CERT_FILE="$f"; break; }
  done
fi
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# ---- the setup's Python (CPython + UnityPy and the image/audio libraries, aarch64)
PY="$W/python/bin/python3.12"
if ! "$PY" -c "import UnityPy, lz4, astc_encoder, PIL" 2>/dev/null; then
  step "unpacking the setup tools"
  rm -rf "$W/python"
  # (gunzip | tar: some firmwares' BusyBox tar has no -z, e.g. muOS)
  ( set -o pipefail; gunzip -c "$S/python.tar.gz" | tar -xf - -C "$W" ) || fail "Could not unpack the setup's Python (see patchlog.txt)."
fi
# the converter as its own checkout lays it out (convert/pmunity beside tools/il2cpp, where its
# IL2CPP step finds its scripts): setup/pmunity and setup64/il2cpp, copied into the work folder
C="$W/converter"
if [ ! -f "$C/.done" ]; then
  rm -rf "$C"; mkdir -p "$C/convert" "$C/tools"
  cp -R "$S/pmunity" "$C/convert/" && { [ ! -d "$S64/il2cpp" ] || cp -R "$S64/il2cpp" "$C/tools/"; } \
    || fail "Could not copy the setup's tools (see patchlog.txt)."
  touch "$C/.done"
fi
export PYTHONPATH="$C/convert" PYTHONDONTWRITEBYTECODE=1
pm() { (cd "$C/convert" && "$PY" -m pmunity "$@"); }

# ---- 1. the game: Cuphead.app, or GOG's macOS installers (as the 32-bit setup)
if [ ! -f "$W/.step_game" ]; then
  if [ ! -f "$D/globalgamemanagers" ]; then
    APP=$(ls -d "$GD"/Cuphead.app "$GD"/*/Cuphead.app 2>/dev/null | head -1)
    if [ -z "$APP" ]; then
      PKGS=$(ls -S "$GD"/*.pkg 2>/dev/null)              # largest first: the game, then the DLC
      if [ -n "$PKGS" ]; then
        room "$PKG_SPACE_MB" || fail "Unpacking the installers and building the 64-bit version need about $((PKG_SPACE_MB / 1000)) GB free on the card ($(free_mb) MB free)."
        step "unpacking GOG's installers (about 10-20 minutes)"
        rm -rf "$W/pkgroot"
        # shellcheck disable=SC2086
        pm macpkg "$W/pkgroot" $PKGS || fail "Could not unpack the installers (see patchlog.txt)."
        APP=$(find "$W/pkgroot" -maxdepth 4 -type d -name 'Cuphead.app' | head -1)
      elif ls "$GD"/setup_cuphead*.exe >/dev/null 2>&1; then
        fail "These are the Windows installers: the port needs the macOS version of Cuphead (its shaders are OpenGL; Windows has only Direct3D). GOG offers both with the game."
      fi
    fi
    [ -n "$APP" ] || fail "Put the installed Cuphead.app (GOG macOS) or GOG's macOS installers (.pkg) in ports/cuphead/gamedata, then launch again."
    [ -f "$APP/Contents/Resources/Data/globalgamemanagers" ] || fail "$(basename "$APP") has no game data."
    grep -aq "2017.4.9f1" "$APP/Contents/Resources/Data/globalgamemanagers" \
      || fail "This Cuphead version is not supported (the port needs 1.3.4, Unity 2017.4.9f1)."
    step "moving the game's data into place"
    cp "$APP/Contents/Resources/"goggame-*.info "$W/" 2>/dev/null   # (beside the data: the DLC check reads them)
    mv "$APP/Contents/Resources/Data" "$D.tmp" && mv "$D.tmp" "$D" || fail "Could not move the game's data (see patchlog.txt)."
    rm -rf "$W/pkgroot" "$APP"
  fi
  [ -f "$W/goggame-2048763853.info" ] && echo "The Delicious Last Course: installed" || echo "The Delicious Last Course: not installed"
  touch "$W/.step_game"
fi

# ---- 2. Unity's 64-bit Android player (IL2CPP) 2017.4.40f1, from Unity
P="$W/player"
if [ ! -f "$W/.step_player" ]; then
  rm -rf "$P"
  I="$GD/$UNITY_EXE"
  if [ -f "$I" ]; then
    step "Unity's 64-bit Android player $UNITY from $UNITY_EXE"
    pm player fetch "$UNITY" "$P" --backend il2cpp --abi arm64-v8a --installer "$I" \
      || fail "Could not read Unity's player from $UNITY_EXE (see patchlog.txt)."
  else
    step "downloading Unity's 64-bit Android player $UNITY from Unity (about 7 MB, needs Wi-Fi)"
    if ! pm player fetch "$UNITY" "$P" --backend il2cpp --abi arm64-v8a --installer "$UNITY_URL"; then
      # the whole installer instead (a few hundred MB), with the system's own downloader
      step "downloading Unity's whole installer instead (a few hundred MB)"
      I="$W/$UNITY_EXE"; rm -f "$I"
      if command -v curl >/dev/null; then curl -fL --retry 3 -o "$I" "$UNITY_URL"; else wget -O "$I" "$UNITY_URL"; fi \
        || fail "Downloading Unity's player failed: is Wi-Fi on? (Or put $UNITY_EXE in ports/cuphead/gamedata.)"
      rm -rf "$P"
      pm player fetch "$UNITY" "$P" --backend il2cpp --abi arm64-v8a --installer "$I" \
        || fail "Could not read Unity's player (see patchlog.txt)."
      rm -f "$I"
    fi
  fi
  for kv in $PLAYER_SHA256; do
    f=${kv%%=*}; h=${kv#*=}
    [ "$(sha256sum "$PLAYER_LIBS/$f" 2>/dev/null | cut -d' ' -f1)" = "$h" ] \
      || fail "Unity's player file $f is not the one this port was made with (checksum)."
  done
  touch "$W/.step_player"
fi

# ---- 3. conversion: GLES3 shaders, settings, ASTC textures, audio, the helper's animation table
# (as the 32-bit setup; texture quality: this setup's first answer, else PortMaster's question,
# else setup.txt, else medium)
Q=$(cat "$W/.texture_quality" 2>/dev/null)
[ -n "$Q" ] || Q=${TEXTURE_QUALITY:-$(sed -n 's/^[[:space:]]*texture_quality[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$GAMEDIR/setup.txt" 2>/dev/null | tail -1)}
case "$Q" in fast|medium) ;; *) Q=medium;; esac
echo "$Q" > "$W/.texture_quality"
if [ ! -f "$W/.step_convert" ]; then
  step "converting the game (one to a few hours; it continues where it stopped if interrupted)"
  echo "texture quality: $Q"
  pm convert "$D" --config "$S/cuphead.json" --plugin "$S/animclips.py" --set textures.quality="$Q" \
    || fail "Converting the game's files failed (see patchlog.txt). Launch again to continue."
  touch "$W/.step_convert"
fi

# ---- 4. the game's code with the port's patches and helper, as the 32-bit setup applies them:
# codepatch --target=android on the original Assembly-CSharp.dll (the data's Managed/ stays as it
# is), CupheadPort.dll beside it; IL2CPP compiles them instead of the data's copy (--managed-file)
MP="$W/managed"
if [ ! -f "$W/.step_code" ]; then
  step "patching the game's code for the port"
  chmod +x "$S/codepatch"
  rm -rf "$MP.tmp"
  "$S/codepatch" --target=android "$D/Managed" "$MP.tmp" || fail "Patching the game's code failed (see patchlog.txt)."
  cp "$S/CupheadPort.dll" "$MP.tmp/" && rm -rf "$MP" && mv "$MP.tmp" "$MP" || fail "Could not keep the patched code (see patchlog.txt)."
  touch "$W/.step_code"
fi

# ---- 5. IL2CPP: the game's code compiled for the 64-bit player, on the handheld
# The converter's il2cpp command with --on-device: its compilers and Mono come as Debian arm64
# packages (fetched into --home, checked against pinned checksums) and run from there, nothing
# installed; jobs follow the free memory; a killed build continues where it stopped. What this
# step calls (a converter whose `il2cpp --help` lacks --on-device or --managed-file stops here
# with a message):
#   pm il2cpp fetch <version> --on-device --abi arm64-v8a --net 2subset --pkg <player> --home <dir>
#       Unity's il2cpp of <version>, the .NET 3.5 class libraries (Cuphead's runtime), the NDK's
#       target files and the handheld's compiler tools, into <dir> (resumable)
#   pm il2cpp <data> <out> --on-device --abi arm64-v8a --unity <version> --pkg <player> --home <dir>
#             --managed-file <patched Assembly-CSharp.dll> --managed-file <CupheadPort.dll>
#             [--link-xml setup64/link.xml]
#       the build: <out>/lib/arm64-v8a/libil2cpp.so, <out>/Data/Managed/{Metadata,Resources,etc},
#       <out>/il2cpp.json (<out>/.work: the build files and logs)
H="$W/il2cpp-home"; IL="$W/il2cpp"
run_last() {   # run_last <command...>: the command's exit code; its last output line in $last
  "$@" 2>&1 | tee "$W/last.log"; local rc=${PIPESTATUS[0]}
  last=$(grep -v '^[[:space:]]*$' "$W/last.log" | tail -1); rm -f "$W/last.log"; return "$rc"
}
if [ ! -f "$W/.step_il2cpp" ]; then
  ih=$(pm il2cpp --help 2>/dev/null)
  case "$ih" in *--on-device*) case "$ih" in *--managed-file*) ;; *) ih=;; esac;; *) ih=;; esac
  [ -n "$ih" ] || fail "This release cannot compile Cuphead's code on the handheld yet (the IL2CPP step). Build the 64-bit version on a computer instead (build64.sh, see ports/cuphead/README.md)."
  extra=()                                 # Cuphead's link.xml: what its code reaches by reflection
  case "$ih" in *--link-xml*) [ -f "$S64/link.xml" ] && extra+=(--link-xml "$S64/link.xml");; esac
  if [ ! -f "$W/.step_il2cpp_tools" ]; then
    step "downloading the tools that compile the game's code: Unity's IL2CPP $UNITY, parts of the Android NDK, compilers (needs Wi-Fi)"
    run_last pm il2cpp fetch "$UNITY" --on-device --abi arm64-v8a --net 2subset --pkg "$P" --home "$H" \
      || fail "Downloading the IL2CPP tools failed: $last (is Wi-Fi on? see patchlog.txt)"
    touch "$W/.step_il2cpp_tools"
  fi
  room "$IL2CPP_SPACE_MB" || fail "Compiling the game's code needs about $((IL2CPP_SPACE_MB / 1000)) GB free on the card ($(free_mb) MB free)."
  step "compiling the game's code for the 64-bit player (IL2CPP: the longest part, hours; it continues where it stopped if interrupted)"
  run_last pm il2cpp "$D" "$IL" --on-device --abi arm64-v8a --unity "$UNITY" --pkg "$P" --home "$H" \
    --managed-file "$MP/Assembly-CSharp.dll" --managed-file "$MP/CupheadPort.dll" "${extra[@]}" \
    || fail "Compiling the game's code failed: $last (see patchlog.txt). Launch again to continue, or build the 64-bit version on a computer (build64.sh)."
  [ -f "$IL/lib/arm64-v8a/libil2cpp.so" ] && [ -f "$IL/il2cpp.json" ] || fail "The IL2CPP build is incomplete (see patchlog.txt)."
  rm -rf "$IL/.work" "$H"                  # (the build files and the tools: not needed any more)
  touch "$W/.step_il2cpp"
fi

# ---- 6. what Unity's player reads: the APK (the data's files are moved into it), with IL2CPP's
# metadata instead of the assemblies (the helper's code is in libil2cpp.so). IL2CPP has no Mono
# dllmap: the helper's DllImport("SDL2") goes through ua_host's plugin map (plugins-il2cpp.json)
if [ ! -f "$W/.step_package" ]; then
  step "packing the game for the player"
  extra=(); [ -f "$S64/plugins-il2cpp.json" ] && extra=(--plugin-map "$S64/plugins-il2cpp.json")
  pm android-data --src "$D" --pkg "$P" --out "$W/android" --name Cuphead --package com.cupheadport.game \
    --root-file animclips.txt --il2cpp "$IL" "${extra[@]}" \
    --consume-src --verify-bundles 2 --pack all --no-video-shader \
    || fail "Packing the game failed (see patchlog.txt). Launch again to continue."
  touch "$W/.step_package"
fi

# ---- 7. into place: ports/cuphead/arm64/
step "installing"
Z="$W/android/zip"
mkdir -p "$A/lib"
for f in "$PLAYER_LIBS/libmain.so" "$PLAYER_LIBS/libunity.so" "$IL/lib/arm64-v8a/libil2cpp.so"; do
  cp "$f" "$A/lib/" || fail "Could not install Unity's player."
done
[ -d "$Z/assets" ] && rm -rf "$A/assets"        # (an interrupted install moved it already)
for f in "$Z"/*; do
  [ -e "$f" ] || continue
  mv -f "$f" "$A/" || fail "Could not install $(basename "$f")."
done
# the 32-bit build's saves and settings on this card, if any, are copied once (not its shader cache)
if [ -d "$GAMEDIR/data" ] && [ ! -d "$A/data" ]; then
  mkdir -p "$A/data.tmp"
  for f in "$GAMEDIR/data"/*; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = cache ] || cp -R "$f" "$A/data.tmp/" || fail "Could not copy the 32-bit build's saves (see patchlog.txt)."
  done
  mv "$A/data.tmp" "$A/data" && echo "copied the 32-bit build's saves (ports/cuphead/data) to ports/cuphead/arm64/data"
fi
sync
touch "$GAMEDIR/.cuphead_ready64"
# the tools: setup64/ and the work folder, and setup/ unless this system can still run the 32-bit
# build, which is not set up yet (its setup needs setup/)
rm -rf "$W" "$S64"
if [ -e /lib/ld-linux-armhf.so.3 ] && [ ! -f "$GAMEDIR/.cuphead_ready" ]; then
  echo "kept setup/ (this system can run the 32-bit build, which is not set up yet)"
else
  rm -rf "$S"
fi
# the installers (or what is left of Cuphead.app) are not needed any more: removed, as the 32-bit
# setup does, unless setup.txt says keep_installers=1
keep=$(sed -n 's/^[[:space:]]*keep_installers[[:space:]]*=[[:space:]]*\([01]\).*/\1/p' "$GAMEDIR/setup.txt" 2>/dev/null | tail -1)
left=$(ls -d "$GD"/*.pkg "$GD"/*.app 2>/dev/null)
if [ -n "$left" ] && [ "$keep" != 1 ]; then
  freed=$(IFS=$'\n'; du -scm $left 2>/dev/null | tail -1 | cut -f1)
  (IFS=$'\n'; rm -rf $left)
  echo "removed the installers from gamedata/ (${freed} MB; keep_installers=1 in setup.txt keeps them)"
elif [ -n "$left" ]; then
  echo "kept the installers in gamedata/ (keep_installers=1)"
fi
sync
step "setup finished: $(du -sm "$A" | cut -f1) MB in ports/cuphead/arm64."
